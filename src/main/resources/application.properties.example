# =============================================================================
# LOCAL DEVELOPMENT TEMPLATE
# Copy this file to application-dev.properties or application.properties
# and fill in your local credentials.
# =============================================================================

spring.application.name=dental-management-backend
spring.profiles.active=dev

# MySQL Configuration - Set these as environment variables in production
spring.datasource.url=jdbc:mysql://localhost:3306/dental_management?createDatabaseIfNotExist=true
spring.datasource.username=root
spring.datasource.password=your_password_here

# JPA Configuration
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect

# Spring Actuator — expose health & metrics endpoints
management.endpoints.web.exposure.include=health,metrics,info,prometheus
management.endpoint.health.show-details=always
management.metrics.export.prometheus.enabled=true

# OpenTelemetry
otel.service.name=${OTEL_SERVICE_NAME:dental-management-backend}
otel.exporter.otlp.endpoint=${OTEL_EXPORTER_OTLP_ENDPOINT:}
otel.exporter.otlp.protocol=${OTEL_EXPORTER_OTLP_PROTOCOL:http/protobuf}
otel.logs.exporter=${OTEL_LOGS_EXPORTER:otlp}
otel.metrics.exporter=${OTEL_METRICS_EXPORTER:otlp}
otel.traces.exporter=${OTEL_TRACES_EXPORTER:otlp}

# JWT Configuration (generate a secure 256-bit base64 secret in production)
jwt.secret=${JWT_SECRET:dGVzdC1zZWNyZXQta2V5LWZvci1qd3QtYXV0aGVudGljYXRpb24tZGVudGFsLW1hbmFnZW1lbnQ=}
jwt.expiration-ms=${JWT_EXPIRATION_MS:86400000}
